# Copie para .env.local no desenvolvimento ou configure no ambiente de build.
# Toda variavel VITE_* e incorporada ao JavaScript publico. Nunca coloque
# senhas, segredos JWT ou credenciais do banco neste arquivo.

# Origem publica da API Node.js. Aceita https://dominio ou https://dominio/api.
# Em producao esta variavel e obrigatoria; vazia mantem o modo demonstracao local.
# Para o ambiente atual: VITE_API_URL="https://backendportfolio.khalifadeveloper.com.br"
VITE_API_URL=""

# Somente para homologacao local. Nunca configure estas variaveis no build de producao.
VITE_DEMO_ADMIN_PASSWORD=""
VITE_DEMO_COLLABORATOR_PASSWORD=""
